definition
	CLUSTER[at0000] matches {    -- Pharmacy withdrawal percentage
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Withdrawal percentage from CatSalut pharmacies
				value matches {
					DV_PROPORTION matches {*}
				}
			}
		}
	}

