definition
	CLUSTER[at0000] matches {    -- Logos
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- EP logo
				value matches {
					DV_URI matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- UP logo
				value matches {
					DV_URI matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Centre logo
				value matches {
					DV_URI matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- SA logo
				value matches {
					DV_URI matches {*}
				}
			}
		}
	}

