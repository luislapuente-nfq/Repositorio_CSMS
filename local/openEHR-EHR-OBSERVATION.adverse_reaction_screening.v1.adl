		["ca"] = <
			items = <
				["at0000"] = <
					text = <"Qüestionari de cribratge de reaccions adverses">
					description = <"Sèrie de preguntes i respostes associades utilitzades per fer un cribratge de la presència de qualsevol reacció adversa prèvia.">
					comment = <"Les respostes poden ser autoinformades.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Qualsevol esdeveniment">
					description = <"Esdeveniment predeterminat, sense especificar, de tipus puntual o d'interval, que es pot definir explícitament en una plantilla o en temps d'execució.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Nom de la substància">
					description = <"Identificació d'una substància, o classe de substàncies, a la qual la persona pot haver tingut reaccions prèvies.">
					comment = <"Tant una substància individual com una classe de substàncies són entrades vàlides a «Substància». Una substància pot ser un compost de substàncies més simples, per exemple un producte medicinal.">
				>
				["at0005"] = <
					text = <"Presència?">
					description = <"Hi ha antecedents de reaccions adverses al «Nom de la substància», rellevants per a la finalitat del cribratge?">
					comment = <"En una plantilla, aquest element de dades normalment es reanomena amb la pregunta concreta formulada. El conjunt de valors proposat es pot adaptar per a l'ús local mitjançant l'elecció del tipus de dada DV_TEXT o DV_BOOLEAN segons el cas d'ús concret.">
				>
				["at0007"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0021"] = <
					text = <"Extensió">
					description = <"Informació addicional necessària per ampliar el model amb contingut local o per alinear-se amb altres models o formalismes de referència.">
					comment = <"Per exemple: requisits d'informació local; o metadades addicionals per alinear-se amb FHIR.">
				>
				["at0022"] = <
					text = <"Reacció adversa específica">
					description = <"Detalls sobre una reacció adversa específica a una substància identificada, o classe o agrupació de substàncies, rellevant per a la finalitat del cribratge.">
				>
				["at0025"] = <
					text = <"Comentari">
					description = <"Narrativa addicional sobre la pregunta específica de reacció adversa, no recollida en altres camps.">
				>
				["at0028"] = <
					text = <"Alguna reacció adversa?">
					description = <"Hi ha antecedents de qualsevol reacció adversa rellevant per a la finalitat del cribratge?">
					comment = <"En una plantilla, aquest element de dades normalment es reanomena amb la pregunta concreta formulada. El conjunt de valors proposat es pot adaptar per a l'ús local mitjançant l'elecció del tipus de dada DV_TEXT o DV_BOOLEAN segons el cas d'ús concret.">
				>
				["at0034"] = <
					text = <"Finalitat del cribratge">
					description = <"El context o motiu del cribratge.">
					comment = <"Aquest element de dades té com a finalitat proporcionar el context de recollida per als grups de preguntes/respostes quan es consultin posteriorment. No s'espera que aquest element de dades es mostri a la persona, sinó que només es desi a les dades.
Per exemple: cribratge previ a l'ingrés o el nom del qüestionari concret.">
				>
				["at0039"] = <
					text = <"Detalls addicionals">
					description = <"Detalls o preguntes estructurats sobre la reacció adversa específica.">
					comment = <"Per exemple: hospital on es va tractar.">
				>
				["at0040"] = <
					text = <"Temporització">
					description = <"Indicació de la temporització relacionada amb la reacció adversa.">
					comment = <"L'element de dades «Temporització» s'ha modelat deliberadament de manera flexible per admetre la multitud de formes en què es pot utilitzar en qüestionaris per registrar l'inici o el moment d'una reacció adversa. La semàntica específica i prevista es pot precisar més en una plantilla.

Per exemple:
– Data/hora per a la data d'inici d'una reacció adversa.
– Interval de data/hora per a un període de temps, per exemple entre 1940 i 1942.
– Text per a descripcions com «Immediatament després de la picada d'abella» o «Fa una setmana».
– Durada per a l'edat de la persona en el moment de l'inici.
– Interval de durada per a un rang d'edat aproximat en el moment de l'inici.">
				>
				["at0042"] = <
					text = <"Detalls addicionals">
					description = <"Detalls o preguntes estructurats sobre el cribratge de reaccions adverses.">
				>
				["at0043"] = <
					text = <"Descripció">
					description = <"Descripció narrativa sobre els antecedents de qualsevol reacció adversa rellevant per a la finalitat del cribratge.">
				>
				["at0044"] = <
					text = <"Sí">
					description = <"">
				>
				["at0045"] = <
					text = <"No">
					description = <"">
				>
				["at0046"] = <
					text = <"Desconegut">
					description = <"">
				>
				["at0047"] = <
					text = <"Insegur">
					description = <"">
				>
				["at0052"] = <
					text = <"Sí">
					description = <"">
				>
				["at0053"] = <
					text = <"No">
					description = <"">
				>
				["at0054"] = <
					text = <"Desconegut">
					description = <"">
				>
				["at0055"] = <
					text = <"Insegur">
					description = <"">
				>
			>
		>
		["es"] = <
			items = <
				["at0000"] = <
					text = <"Cuestionario de cribado de reacciones adversas">
					description = <"Serie de preguntas y respuestas asociadas utilizadas para cribar la presencia de cualquier reacción adversa previa.">
					comment = <"Las respuestas pueden ser autoinformadas.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Cualquier evento">
					description = <"Evento predeterminado, no especificado, de tipo puntual o de intervalo, que puede definirse explícitamente en una plantilla o en tiempo de ejecución.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Nombre de la sustancia">
					description = <"Identificación de una sustancia, o clase de sustancias, a la que la persona puede haber tenido reacciones previas.">
					comment = <"Tanto una sustancia individual como una clase de sustancias son entradas válidas en «Sustancia». Una sustancia puede ser un compuesto de sustancias más simples, por ejemplo un producto medicinal.">
				>
				["at0005"] = <
					text = <"¿Presencia?">
					description = <"¿Existen antecedentes de reacciones adversas al «Nombre de la sustancia», relevantes para la finalidad del cribado?">
					comment = <"En una plantilla, este elemento de datos normalmente se renombra con la pregunta concreta formulada. El conjunto de valores propuesto puede adaptarse para el uso local mediante la elección del tipo de dato DV_TEXT o DV_BOOLEAN según el caso de uso concreto.">
				>
				["at0007"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0021"] = <
					text = <"Extensión">
					description = <"Información adicional necesaria para ampliar el modelo con contenido local o para alinearse con otros modelos o formalismos de referencia.">
					comment = <"Por ejemplo: requisitos de información local; o metadatos adicionales para alinearse con FHIR.">
				>
				["at0022"] = <
					text = <"Reacción adversa específica">
					description = <"Detalles sobre una reacción adversa específica a una sustancia identificada, o clase o agrupación de sustancias, relevante para la finalidad del cribado.">
				>
				["at0025"] = <
					text = <"Comentario">
					description = <"Narrativa adicional sobre la pregunta específica de reacción adversa, no recogida en otros campos.">
				>
				["at0028"] = <
					text = <"¿Alguna reacción adversa?">
					description = <"¿Existen antecedentes de cualquier reacción adversa relevante para la finalidad del cribado?">
					comment = <"En una plantilla, este elemento de datos normalmente se renombra con la pregunta concreta formulada. El conjunto de valores propuesto puede adaptarse para el uso local mediante la elección del tipo de dato DV_TEXT o DV_BOOLEAN según el caso de uso concreto.">
				>
				["at0034"] = <
					text = <"Finalidad del cribado">
					description = <"El contexto o motivo del cribado.">
					comment = <"Este elemento de datos tiene como finalidad proporcionar el contexto de recogida para los grupos de preguntas/respuestas cuando se consulten posteriormente. No se espera que este elemento de datos se muestre a la persona, sino que solo se almacene en los datos.
Por ejemplo: cribado previo al ingreso o el nombre del cuestionario concreto.">
				>
				["at0039"] = <
					text = <"Detalles adicionales">
					description = <"Detalles o preguntas estructurados sobre la reacción adversa específica.">
					comment = <"Por ejemplo: hospital donde se trató.">
				>
				["at0040"] = <
					text = <"Temporización">
					description = <"Indicación de la temporización relacionada con la reacción adversa.">
					comment = <"El elemento de datos «Temporización» se ha modelado deliberadamente de forma flexible para admitir la multitud de formas en que puede utilizarse en cuestionarios para registrar el inicio o el momento de una reacción adversa. La semántica específica y prevista puede precisarse más en una plantilla.

Por ejemplo:
– Fecha/hora para la fecha de inicio de una reacción adversa.
– Intervalo de fecha/hora para un período de tiempo, por ejemplo entre 1940 y 1942.
– Texto para descripciones como «Inmediatamente después de la picadura de abeja» o «Hace una semana».
– Duración para la edad de la persona en el momento del inicio.
– Intervalo de duración para un rango de edad aproximado en el momento del inicio.">
				>
				["at0042"] = <
					text = <"Detalles adicionales">
					description = <"Detalles o preguntas estructurados sobre el cribado de reacciones adversas.">
				>
				["at0043"] = <
					text = <"Descripción">
					description = <"Descripción narrativa sobre los antecedentes de cualquier reacción adversa relevante para la finalidad del cribado.">
				>
				["at0044"] = <
