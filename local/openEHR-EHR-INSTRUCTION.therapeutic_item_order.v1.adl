				["at0143"] = <
					text = <"Detalles del artículo">
					description = <"Detalles estructurados sobre el artículo.">
					comment = <"Por ejemplo: tamaño y/o modelo.">
				>
				["at0148"] = <
					text = <"Intención terapéutica">
					description = <"La intención terapéutica del artículo.">
					comment = <"Por ejemplo: «alivio del dolor». Se prefiere la codificación de la intención terapéutica con una terminología, cuando sea posible. Este elemento de datos permite múltiples ocurrencias.">
				>
				["at0166"] = <
					text = <"Detalles adicionales">
					description = <"Detalles estructurados adicionales sobre la orden, no recogidos en otros campos.">
				>
				["at0167"] = <
