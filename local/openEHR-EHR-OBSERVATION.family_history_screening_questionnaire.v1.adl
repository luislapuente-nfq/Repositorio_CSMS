				["at0041"] = <
					text = <"Insegur">
					description = <"">
				>
				["at0042"] = <
					text = <"Qualsevol familiar">
					description = <"Presència d'un problema o diagnòstic específic en qualsevol familiar.">
					comment = <"El «Nom del problema/diagnòstic» s'ha fet obligatori, ja que és l'únic objecte de la pregunta i no s'esperen més detalls. Per exemple: «Algú de la família té diabetis?».">
				>
				["at0043"] = <
					text = <"Nom del problema/diagnòstic">
					description = <"Identificació d'un problema o diagnòstic específic, o d'una agrupació de problemes o diagnòstics, en la família.">
					comment = <"Per exemple: «Càncer colorectal» o «Càncer»; «Angina» o «Malaltia cardiovascular». Es prefereix la codificació del «Nom del problema/diagnòstic» amb una terminologia, quan sigui possible.">
				>
				["at0044"] = <
					text = <"Presència?">
					description = <"Hi ha antecedents d'un problema o diagnòstic, o d'una agrupació de problemes o diagnòstics, en la família?">
					comment = <"En una plantilla, aquest element de dades normalment es reanomena amb la pregunta concreta formulada. El conjunt de valors proposat es pot adaptar per a l'ús local mitjançant l'elecció del tipus de dada DV_TEXT o DV_BOOLEAN segons el cas d'ús concret. En els casos en què una persona és adoptada i no es disposa d'informació, es recomana registrar «Desconegut». Per exemple: Algú de la teva família té diabetis?">
				>
				["at0045"] = <
					text = <"Sí">
					description = <"">
