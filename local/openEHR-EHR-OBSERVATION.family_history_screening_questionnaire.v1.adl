					text = <"Insegur">
					description = <"">
				>
				["at0049"] = <
					text = <"Temporització">
					description = <"Indicació de la temporització relacionada amb el problema o diagnòstic.">
					comment = <"L'element de dades «Temporització» s'ha modelat deliberadament de manera flexible per admetre la multitud de formes en què es pot utilitzar en qüestionaris per registrar quan es va produir un problema o diagnòstic. La semàntica específica i prevista es pot precisar més en una plantilla. Per exemple: la data i/o hora concretes; l'hora d'inici i final del problema o diagnòstic; l'interval de temps durant el qual es va produir; la durada del problema o diagnòstic; l'edat de la persona en el moment del problema o diagnòstic; o el temps transcorregut des que es va produir. És vàlida una data parcial, utilitzant el tipus de dada DV_DATE_TIME, per registrar només un any.">
				>
				["at0050"] = <
					text = <"Comentari">
					description = <"Narrativa addicional sobre el problema o diagnòstic específic en la família, no recollida en altres camps.">
				>
			>
		>
