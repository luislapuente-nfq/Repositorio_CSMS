					description = <"Identificación de un problema o diagnóstico, o agrupación de problemas o diagnósticos, en la familia.">
					comment = <"Se prefiere la codificación del «Nombre del problema/diagnóstico» con una terminología, cuando sea posible.">
				>
				["at0036"] = <
