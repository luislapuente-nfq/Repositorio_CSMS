					text = <"Desconocido">
					description = <"">
				>
				["at0018"] = <
					text = <"Relación">
					description = <"La relación del familiar con la persona.">
					comment = <"Por ejemplo: familiar de primer grado, madre, padrastro, abuela materna o tío paterno. Se prefiere la codificación de la relación con una terminología, cuando sea posible, incluyendo la especificación de materno y paterno si procede.">
				>
				["at0021"] = <
