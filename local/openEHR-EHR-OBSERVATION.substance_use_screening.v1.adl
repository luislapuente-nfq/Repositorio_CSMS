				["at0024"] = <
					text = <"¿Utilizado?">
					description = <"¿Existen antecedentes de uso de una sustancia específica o clase/agrupación de sustancias?">
					comment = <"En una plantilla, este elemento de datos normalmente se renombra con la pregunta concreta formulada. El conjunto de valores propuesto puede adaptarse para el uso local mediante la elección del tipo de dato DV_TEXT o DV_BOOLEAN según el caso de uso concreto. Por ejemplo, un conjunto de valores alternativo utilizando el tipo de dato DV_TEXT puede ser: Usuario actual; Nunca utilizado; Usuario anterior; Desconocido.">
				>
