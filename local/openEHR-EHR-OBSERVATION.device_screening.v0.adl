		["ca"] = <
			items = <
				["at0000"] = <
					text = <"Qüestionari de cribratge de dispositius mèdics">
					description = <"Sèrie de preguntes i respostes associades utilitzades per fer un cribratge de la presència de dispositius mèdics implantats o l'ús d'ajudes tècniques.">
					comment = <"Les respostes poden ser autoinformades.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Qualsevol esdeveniment">
					description = <"Esdeveniment predeterminat, sense especificar, de tipus puntual o d'interval, que es pot definir explícitament en una plantilla o en temps d'execució.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Nom del dispositiu">
					description = <"Nom del dispositiu mèdic implantat o tipus de dispositiu objecte del cribratge.">
				>
				["at0005"] = <
					text = <"Presència?">
					description = <"Presència del dispositiu implantat.">
				>
				["at0007"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0021"] = <
					text = <"Extensió">
					description = <"Informació addicional necessària per ampliar el model amb contingut local o per alinear-se amb altres models o formalismes de referència.">
					comment = <"Per exemple: requisits d'informació local; o metadades addicionals per alinear-se amb FHIR.">
				>
				["at0022"] = <
					text = <"Cribratge de dispositiu implantat">
					description = <"Detalls del cribratge sobre la presència d'un dispositiu mèdic implantat específic.">
					comment = <"Per exemple: implant coclear; marcapassos; pròtesi articular; vàlvula cardíaca; estent coronari; dispositiu de fixació òssia (p. ex. cargols o plaques); estimulador cerebral profund; lent intraocular; o dispositiu anticonceptiu.">
				>
				["at0023"] = <
					text = <"Sí">
					description = <"El dispositiu específic està present o s'està utilitzant.">
				>
				["at0024"] = <
					text = <"No">
					description = <"El dispositiu específic no està present ni s'utilitza.">
				>
				["at0025"] = <
					text = <"Comentari">
					description = <"Narrativa addicional sobre el dispositiu implantat, no recollida en altres camps.">
				>
				["at0027"] = <
					text = <"Desconegut">
					description = <"No se sap si el dispositiu és present o absent.">
				>
				["at0028"] = <
					text = <"Algun dispositiu mèdic implantat?">
					description = <"Presència de qualsevol dispositiu implantat.">
				>
				["at0031"] = <
					text = <"Sí">
					description = <"">
				>
				["at0032"] = <
					text = <"No">
					description = <"">
				>
				["at0033"] = <
					text = <"Desconegut">
					description = <"">
				>
				["at0034"] = <
					text = <"Finalitat del cribratge">
					description = <"El motiu del cribratge general.">
					comment = <"Per exemple: cribratge previ a una exploració de ressonància magnètica.">
				>
				["at0039"] = <
					text = <"Detalls del cribratge">
					description = <"Detalls o preguntes addicionals sobre el dispositiu implantat.">
				>
				["at0040"] = <
					text = <"Descripció">
					description = <"Descripció narrativa sobre el dispositiu implantat.">
				>
				["at0041"] = <
					text = <"Cribratge d'ajuda tècnica">
					description = <"Detalls del cribratge sobre l'ús d'un dispositiu mèdic d'ajuda tècnica específic.">
					comment = <"Per exemple: cadira de rodes; bastó; audiòfon; ulleres de lectura; pròtesi de membre; lector de braille; dispositiu generador de veu o organitzador de medicació.">
				>
				["at0042"] = <
					text = <"Nom de l'ajuda tècnica">
					description = <"Nom del dispositiu mèdic o tipus de dispositiu objecte del cribratge.">
				>
				["at0043"] = <
					text = <"Presència?">
					description = <"Ús de l'ajuda tècnica.">
				>
				["at0044"] = <
					text = <"Sí">
					description = <"El dispositiu específic està present o s'està utilitzant.">
				>
				["at0045"] = <
					text = <"No">
					description = <"El dispositiu específic no està present ni s'utilitza.">
				>
				["at0046"] = <
					text = <"Desconegut">
					description = <"No se sap si el dispositiu és present o absent.">
				>
				["at0047"] = <
					text = <"Descripció">
					description = <"Descripció narrativa sobre l'ajuda tècnica.">
				>
				["at0048"] = <
					text = <"Detalls del cribratge">
					description = <"Detalls o preguntes addicionals sobre l'ajuda tècnica.">
				>
				["at0049"] = <
					text = <"Comentari">
					description = <"Narrativa addicional sobre l'ajuda tècnica, no recollida en altres camps.">
				>
				["at0050"] = <
					text = <"Temporització">
					description = <"Indicació de la temporització relacionada amb el dispositiu implantat.">
					comment = <"L'element de dades «Temporització» s'ha modelat deliberadament de manera flexible per admetre la multitud de formes en què es pot utilitzar en qüestionaris per registrar quan es va implantar un dispositiu mèdic. La semàntica específica i prevista es pot precisar més en una plantilla. Per exemple: la data i/o hora concretes; les dates d'inserció o retirada de l'implant; l'interval de temps durant el qual es va mantenir l'implant; la durada de l'implant; l'edat de la persona en el moment de la inserció de l'implant; o el temps transcorregut des de la seva inserció o retirada. És vàlida una data parcial, utilitzant el tipus de dada DV_DATE_TIME, per registrar només un any.">
				>
				["at0051"] = <
					text = <"Insegur">
					description = <"">
				>
				["at0052"] = <
					text = <"Insegur">
					description = <"">
				>
				["at0053"] = <
					text = <"Insegur">
					description = <"">
				>
			>
		>
		["es"] = <
			items = <
				["at0000"] = <
					text = <"Cuestionario de cribado de dispositivos médicos">
					description = <"Serie de preguntas y respuestas asociadas utilizadas para cribar la presencia de dispositivos médicos implantados o el uso de ayudas técnicas.">
					comment = <"Las respuestas pueden ser autoinformadas.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Cualquier evento">
					description = <"Evento predeterminado, no especificado, de tipo puntual o de intervalo, que puede definirse explícitamente en una plantilla o en tiempo de ejecución.">
				>
				["at0003"] = <
					text = <"Tree">
