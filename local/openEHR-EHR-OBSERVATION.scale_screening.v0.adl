					text = <"Desconegut">
					description = <"">
				>
				["at0036"] = <
					text = <"Sí">
					description = <"">
				>
				["at0037"] = <
					text = <"No">
					description = <"">
				>
				["at0039"] = <
					text = <"Desconegut">
					description = <"">
				>
				["at0040"] = <
					text = <"Propòsit del cribratge">
					description = <"Context o motiu del cribatge.">
					comment = <"Aquest element de dades està destinat a proporcionar un context de la recopilació dels grups de preguntes/respostes quan es consulti en una data posterior. No s'espera que aquest element de dades s'exposi a l'individu, sinó que només s'emmagatzemi en les dades. Per exemple: revisió prèvia a l'admissió, el nom del propi qüestionari o comprovació de les escales clíniques prèvies.">
				>
				["at0041"] = <
					text = <"Detalls addicionals">
					description = <"Detalls estructurats o qüestions sobre l'escala clínica o \"score\".">
				>
				["at0043"] = <
					text = <"Descripció">
					description = <"Descripció narrativa sobre la història de qualsevol escala clínica o \"score\" rellevant per al propòsit del cribatge.">
				>
				["at0044"] = <
					text = <"Detalls addicionals">
